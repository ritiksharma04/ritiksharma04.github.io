---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import projects from '../../data/projects.json';

const publishedProjects = projects.filter((project) => project.published !== false);
---

<PortfolioLayout
	title="Projects | Ritik Sharma"
	description="Selected Python projects by Ritik Sharma, including backend applications and a structured data extraction pipeline."
>
	<header class="page-intro">
		<p class="eyebrow">Projects</p>
		<h1>Work, with the details behind it.</h1>
		<p>A few projects I’ve built or am exploring. Each page explains what the code does and what can be verified from the project itself.</p>
	</header>
	<section class="project-grid project-index" aria-label="Selected projects">
		{publishedProjects.map((project) => (
			<article class="project-card">
				<p class="section-kicker">{project.status || 'Project'}</p>
				<h2>{project.name}</h2>
				<p>{project.description}</p>
				<div class="tag-list">{project.tech.map((technology) => <span class="tag">{technology}</span>)}</div>
				<a class="text-link" href={`/projects/${project.id}/`}>Read the project notes →</a>
			</article>
		))}
	</section>
</PortfolioLayout>

<style>
	.project-index { padding-bottom: 6rem; }
	.project-index h2 { margin: .2rem 0 .5rem; font: 500 1.65rem var(--serif); }
	.project-index .text-link { display: inline-block; margin-top: 1.2rem; }
</style>
