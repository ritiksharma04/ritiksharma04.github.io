---
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import projects from '../../data/projects.json';

export function getStaticPaths() {
	return projects
		.filter((project) => project.published !== false)
		.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const details = project.details;
const projectSchema = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareSourceCode',
	name: project.name,
	description: project.description,
	codeRepository: project.github,
};
---

<PortfolioLayout title={`${project.name} | Ritik Sharma`} description={project.description}>
	<article class="project-case-study">
		<header class="page-intro">
			<p class="eyebrow"><a href="/projects/">Projects</a> · {project.status || 'Project'}</p>
			<h1>{project.name}</h1>
			<p>{project.description}</p>
			<div class="hero-actions">
				{project.github && <a class="button-link" href={project.github} target="_blank" rel="noopener noreferrer">View source on GitHub ↗</a>}
				{project.live && <a class="text-link" href={project.live} target="_blank" rel="noopener noreferrer">Open live project ↗</a>}
			</div>
			<div class="tag-list">{project.tech.map((technology) => <span class="tag">{technology}</span>)}</div>
		</header>

		{project.image && <img class="case-image" src={`/${project.image}`} alt={`${project.name} screenshot`} loading="lazy" />}

		{details?.context && (
			<section class="case-section">
				<p class="section-kicker">Overview</p>
				<h2>What it does</h2>
				<p>{details.context}</p>
			</section>
		)}

		{details?.architecture?.length > 0 && (
			<section class="case-section">
				<p class="section-kicker">How it works</p>
				<h2>Architecture</h2>
				<ArchitectureDiagram flows={details.architecture} />
			</section>
		)}

		{details?.dataModel?.length > 0 && (
			<section class="case-section">
				<p class="section-kicker">Data</p>
				<h2>Data model</h2>
				<ul>{details.dataModel.map((item) => <li>{item}</li>)}</ul>
			</section>
		)}

		{details?.apiDesign?.length > 0 && (
			<section class="case-section">
				<p class="section-kicker">Interfaces</p>
				<h2>API design</h2>
				<ul>{details.apiDesign.map((item) => <li>{item}</li>)}</ul>
			</section>
		)}

		{details?.implementationNotes && (
			<section class="case-section">
				<p class="section-kicker">Implementation</p>
				<h2>Design notes</h2>
				<p>{details.implementationNotes}</p>
			</section>
		)}

		{details?.challenges?.length > 0 && (
			<section class="case-section"><p class="section-kicker">Problem solving</p><h2>Challenges</h2><ul>{details.challenges.map((item) => <li>{item}</li>)}</ul></section>
		)}
		{details?.tradeoffs?.length > 0 && (
			<section class="case-section"><p class="section-kicker">Engineering choices</p><h2>Trade-offs</h2><ul>{details.tradeoffs.map((item) => <li>{item}</li>)}</ul></section>
		)}
		{details?.whatILearned && (
			<section class="case-section"><p class="section-kicker">Reflection</p><h2>What I learned</h2><p>{details.whatILearned}</p></section>
		)}
		{details?.futureImprovements?.length > 0 && (
			<section class="case-section"><p class="section-kicker">Next</p><h2>Future improvements</h2><ul>{details.futureImprovements.map((item) => <li>{item}</li>)}</ul></section>
		)}

		<p class="back-link"><a href="/projects/">← All projects</a></p>
	</article>
</PortfolioLayout>

<script type="application/ld+json" set:html={JSON.stringify(projectSchema)}></script>

<style>
	.project-case-study { max-width: 880px; margin: auto; padding-bottom: 4rem; }
	.project-case-study .page-intro { padding-bottom: 1.5rem; }
	.project-case-study .page-intro h1 { overflow-wrap: anywhere; }
	.project-case-study .tag-list { margin-top: 1.5rem; }
	.case-image { display: block; width: 100%; height: auto; margin: 1rem 0 2.5rem; border: 1px solid var(--line); }
	.case-section { padding: 2.2rem 0; border-top: 1px solid var(--line); }
	.case-section h2, .case-extra h2 { margin: .25rem 0 .8rem; font: 500 2rem var(--serif); }
	.case-section p:last-child { color: var(--muted); }
	.case-section ul { padding-left: 1.25rem; }
	.case-section li { margin: .5rem 0; }
	.back-link { padding-top: 2rem; border-top: 1px solid var(--line); }
	.back-link a { color: var(--accent-dark); text-underline-offset: .25em; }
</style>
