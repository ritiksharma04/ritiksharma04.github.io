---
import profile from '../data/profile.json';
import socialLinks from '../data/social-links.json';
import skillsData from '../data/skills.json';
import projects from '../data/projects.json';
import experience from '../data/experience.json';
import education from '../data/education.json';
import Header from '../components/Header.astro';

const pageTitle = 'Ritik Sharma | Python Backend Developer';
const pageDescription = 'Python backend developer in Bengaluru building APIs and microservices with FastAPI, PostgreSQL, Docker and Azure, while exploring LLMs, RAG and AI agents.';
const canonicalURL = new URL('/', Astro.site);
const socialImage = new URL('/images/my/circular.png', Astro.site);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Python Backend Developer',
  url: canonicalURL.href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bengaluru',
    addressCountry: 'IN',
  },
  sameAs: [
    'https://github.com/' + socialLinks.github,
    'https://linkedin.com/in/' + socialLinks.linkedin,
  ],
};

const portfolioData = {
  personal: { ...profile, ...socialLinks },
  skillCategories: skillsData.skillCategories,
  skills: skillsData.skills,
  projects,
  experience,
  education,
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={pageDescription}>
  <meta name="author" content="Ritik Sharma">
  <link rel="canonical" href={canonicalURL}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDescription}>
  <meta property="og:image" content={socialImage}>
  <meta property="og:image:alt" content="Portrait of Ritik Sharma">
  <meta property="og:site_name" content="Ritik Sharma">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalURL}>
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={pageDescription}>
  <meta name="twitter:image" content={socialImage}>

  <title>{pageTitle}</title>

  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='12' fill='%23ffffff'/><text x='50' y='65' font-family='Inter, sans-serif' font-size='45' font-weight='700' fill='%23000000' text-anchor='middle'>RS</text></svg>">
<script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Header />

  <main id="main-content">
  <!-- Hero Section -->
  <section id="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-intro">
          <p class="hero-eyebrow">{profile.location}</p>
          <h1 id="nameOutput">{profile.name}</h1>
          <p class="hero-role" id="roleTyping">Python Backend Developer</p>
          <p class="hero-tagline" id="taglineOutput">I build Python backends and am learning how LLMs work from the inside.</p>
        </div>

        <div class="hero-buttons">
          <a href="/resume.pdf" class="btn btn-primary btn-resume" id="resumeBtn" target="_blank">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            View Resume
          </a>
          <a href="#contact" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Contact Me
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Floating Tech Stack Banner -->
  <section id="tech-banner">
    <div class="tech-scroll">
      <div class="tech-track">
        <span class="tech-item">Python</span>
        <span class="tech-dot"></span>
        <span class="tech-item">FastAPI</span>
        <span class="tech-dot"></span>
        <span class="tech-item">Django</span>
        <span class="tech-dot"></span>
        <span class="tech-item">PostgreSQL</span>
        <span class="tech-dot"></span>
        <span class="tech-item">REST APIs</span>
        <span class="tech-dot"></span>
        <span class="tech-item">Redis</span>
        <span class="tech-dot"></span>
        <span class="tech-item">Git</span>
        <span class="tech-dot"></span>
        <span class="tech-item">Docker</span>
        <span class="tech-dot"></span>
        <span class="tech-item">Python</span>
        <span class="tech-dot"></span>
        <span class="tech-item">FastAPI</span>
        <span class="tech-dot"></span>
        <span class="tech-item">Django</span>
        <span class="tech-dot"></span>
        <span class="tech-item">PostgreSQL</span>
        <span class="tech-dot"></span>
        <span class="tech-item">REST APIs</span>
        <span class="tech-dot"></span>
        <span class="tech-item">Redis</span>
        <span class="tech-dot"></span>
        <span class="tech-item">Git</span>
        <span class="tech-dot"></span>
        <span class="tech-item">Docker</span>
        <span class="tech-dot"></span>
      </div>
    </div>
  </section>

  <!-- Experience Section - TIMELINE -->
  <section id="experience" class="fade-in">
    <div class="container">
      <div class="section-header">
        <span class="section-label">My Journey</span>
        <h2 class="section-title">Experience</h2>
      </div>

      <div class="timeline" id="experienceTimeline">
                {experience.map((exp, index) => (
          <div class:list={["timeline-item", index === 0 ? "expanded" : "collapsed"]} data-index={index}>
            <div class="timeline-date"><span class="date-range">{exp.period}</span></div>
            <div class="timeline-content">
              <div class="timeline-card" data-date={exp.period}>
                <button type="button" class="timeline-header" aria-expanded={String(index === 0)} aria-controls={'experience-details-' + index} onclick={'toggleExperience(' + index + ')'}>
                  <span class="timeline-header-info">
                    <span class="timeline-role" role="heading" aria-level="3">{exp.role}</span>
                    <span class="timeline-company">{exp.company}</span>
                  </span>
                  <span class="timeline-toggle" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </button>
                <div class="timeline-details" id={'experience-details-' + index}>
                  <ul class="timeline-highlights">
                    {exp.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="fade-in">
    <div class="container">
      <div class="section-header">
        <span class="section-label">What I Work With</span>
        <h2 class="section-title">Skills & Technologies</h2>
        <p>Click on any skill to see where and how I've used it</p>
      </div>


      <div class="skills-container" id="skillsContainer">
                <div class="skill-tabs" aria-label="Skill categories">
          {portfolioData.skillCategories.map((category, index) => (
            <button type="button" class:list={["skill-tab", index === 0 && "active"]} aria-pressed={String(index === 0)} data-category={category}>
              {category}
            </button>
          ))}
        </div>
        <div class="skill-grids">
          {portfolioData.skillCategories.map((category, index) => (
            <div class:list={["skill-category-grid", index === 0 && "active"]} data-category={category}>
              {portfolioData.skills.filter((skill) => skill.category === category).map((skill) => (
                <button type="button" class="skill-card" aria-haspopup="dialog" onclick={"openSkillModal('" + skill.id + "')"}>
                  <img src={skill.icon} alt="" class="skill-icon" loading="lazy">
                  <span class="skill-name">{skill.name}</span>
                  <span class="skill-level">{skill.level}</span>
                </button>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="fade-in">
    <div class="container">
      <div class="section-header">
        <span class="section-label">My Work</span>
        <h2 class="section-title">Featured Projects</h2>
      </div>

      <div class="projects-grid" id="projectsGrid">
                {projects.filter((project) => project.published !== false).map((project) => (
          <article class="project-card" data-project-id={project.id}>
            <div class="project-preview">
              {project.image ? (
                <img src={'/' + project.image} alt={project.name + ' preview'} loading="lazy">
              ) : (
                <div class="project-preview-placeholder" aria-hidden="true">{project.emoji || 'Python'}</div>
              )}
            </div>
            <div class="project-content">
              <h3 class="project-title">{project.name}</h3>
              <p class="project-description">{project.description}</p>
              <ul class="project-highlights">
                {project.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
              <div class="project-tech">
                {project.tech.map((technology) => <span class="tech-tag">{technology}</span>)}
              </div>
              <div class="project-links">
                <a href={'/projects/' + project.id + '/'} class="btn btn-secondary">Project Notes</a>
                {project.github && <a href={project.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">View Code</a>}
                {project.live && <a href={project.live} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Live Demo</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Education Section - TIMELINE -->
  <section id="education" class="fade-in">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Background</span>
        <h2 class="section-title">Education</h2>
      </div>

      <div class="timeline" id="educationTimeline">
                {education.map((edu) => (
          <div class="timeline-item">
            <div class="timeline-date"><span class="date-range">{edu.period || ''}</span></div>
            <div class="timeline-content">
              <div class="timeline-card" data-date={edu.period || ''}>
                <h3 class="timeline-role">{edu.degree}</h3>
                <p class="timeline-company">{edu.institution}</p>
                <p class="education-details">{edu.details}</p>
                {edu.courses && (
                  <div class="education-courses">
                    <span class="courses-label">Relevant Coursework:</span>
                    <div class="courses-list">
                      {edu.courses.map((course) => <span class="course-tag">{course}</span>)}
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Section - SCALAR STYLE -->
  <section id="contact" class="fade-in">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title" style="font-style: italic;">Let's connect.</h2>
        <p>I'm always open to discussing new opportunities</p>
      </div>


      <div class="contact-links-container" id="contactLinks">
                <div class="contact-link-item">
          <a href={'mailto:' + profile.email}>Send me an Email</a>
          <span>{profile.email}</span>
        </div>
        <div class="contact-link-item">
          <a href={'https://linkedin.com/in/' + socialLinks.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a>
          <span>linkedin.com/in/{socialLinks.linkedin}</span>
        </div>
        <div class="contact-link-item">
          <a href={'https://github.com/' + socialLinks.github} target="_blank" rel="noopener noreferrer">Check my GitHub</a>
          <span>github.com/{socialLinks.github}</span>
        </div>
      </div>
    </div>
  </section>
  </main>

  <!-- Footer -->
  <footer>
    <div class="footer-content">
      <p class="footer-text">&copy; <span id="currentYear">{new Date().getFullYear()}</span> Ritik Sharma. All rights reserved.</p>
    </div>
  </footer>

  <!-- Skill Modal -->
  <div class="modal-overlay" id="skillModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal" style="position: relative;">
      <button type="button" class="modal-close" id="modalClose" aria-label="Close skill details" onclick="closeModal()">&times;</button>
      <div class="modal-header">
        <img alt="" class="modal-icon" id="modalIcon">
        <div class="modal-title-group">
          <h3 id="modalTitle"></h3>
          <span id="modalLevel"></span>
        </div>
      </div>
      <div class="modal-body">
        <div class="modal-section">
          <h4>Where I've Used It</h4>
          <ul class="modal-list" id="modalExperience"></ul>
        </div>
        <div class="modal-section" id="modalProjectsSection">
          <h4>Related Projects</h4>
          <div class="modal-projects" id="modalProjects"></div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ portfolioData }}>
  window.portfolioData = portfolioData;
</script>
<script is:inline src="/scripts.js"></script>
</body>
</html>
