---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			readingMinutes: Math.max(1, Math.ceil(post.body.split(/\s+/).length / 220)),
			related: posts
				.filter((other) => other.id !== post.id && other.data.tags.some((tag) => post.data.tags.includes(tag)))
				.slice(0, 3)
				.map((other) => ({ id: other.id, title: other.data.title, description: other.data.description })),
		},
	}));
}
type Props = { post: CollectionEntry<'blog'>; readingMinutes: number; related: { id: string; title: string; description: string }[] };

const { post, readingMinutes, related } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost {...post.data} readingMinutes={readingMinutes} headings={headings} related={related}>
	<Content />
</BlogPost>
