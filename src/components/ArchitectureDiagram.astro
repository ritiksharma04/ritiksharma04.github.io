---
interface Flow {
	label: string;
	steps: string[];
}

interface Props {
	flows: Flow[];
}

const { flows } = Astro.props;
---

<div class="architecture-diagram">
	{flows.map((flow) => (
		<div class="architecture-lane">
			<h3>{flow.label}</h3>
			<ol class="architecture-flow" aria-label={`${flow.label} flow`}>
				{flow.steps.map((step) => <li>{step}</li>)}
			</ol>
		</div>
	))}
</div>

<style>
	.architecture-diagram { display: grid; gap: 1.25rem; }
	.architecture-lane h3 { margin: 0 0 .7rem; color: var(--muted); font: 700 .78rem var(--sans); letter-spacing: .1em; text-transform: uppercase; }
	.architecture-flow { display: flex; flex-wrap: wrap; align-items: stretch; gap: .65rem; margin: 0; padding: 0; list-style: none; }
	.architecture-flow li { display: flex; align-items: center; min-height: 54px; padding: .65rem .9rem; border: 1px solid var(--line); background: var(--surface); font-size: .9rem; }
	.architecture-flow li + li::before { content: '→'; margin-left: -1.32rem; margin-right: .65rem; color: var(--accent); font-weight: 700; }
	@media (max-width: 760px) {
		.architecture-flow { flex-direction: column; align-items: stretch; }
		.architecture-flow li + li::before { content: '↓'; margin: -1.4rem 0 0; }
	}
</style>
