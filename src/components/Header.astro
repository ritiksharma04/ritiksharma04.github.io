<style is:global>
	.shared-navigation {
		position: fixed;
		inset: 0 0 auto;
		z-index: 1000;
		border-bottom: 1px solid var(--border);
		background: rgba(10, 10, 10, .88);
		backdrop-filter: blur(12px);
	}
	.shared-navigation .nav-container {
		width: min(1200px, calc(100% - 3rem));
		height: 64px;
		margin: auto;
		padding: 0 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}
	.shared-navigation .nav-logo {
		color: var(--text-primary);
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -.02em;
		text-decoration: none;
		white-space: nowrap;
	}
	.shared-navigation .nav-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.shared-navigation .nav-links a {
		position: relative;
		padding: .5rem 0;
		color: var(--text-secondary);
		font-size: .9rem;
		font-weight: 500;
		text-decoration: none;
	}
	.shared-navigation .nav-links a::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 2px;
		background: var(--accent);
		content: '';
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--transition-base);
	}
	.shared-navigation .nav-links a:hover { color: var(--text-primary); }
	.shared-navigation .nav-links a:hover::after { transform: scaleX(1); }
	.shared-navigation .nav-socials { display: flex; align-items: center; gap: 1rem; }
	.shared-navigation .nav-socials a { display: flex; color: var(--text-secondary); }
	.shared-navigation .nav-socials a:hover { color: var(--text-primary); }
	.shared-navigation .nav-socials svg { width: 20px; height: 20px; }
	.shared-navigation .hamburger {
		display: none;
		flex-direction: column;
		gap: 5px;
		padding: .5rem;
		border: 0;
		background: transparent;
		cursor: pointer;
	}
	.shared-navigation .hamburger span { width: 24px; height: 2px; background: var(--text-primary); transition: transform .2s ease, opacity .2s ease; }
	.shared-navigation .hamburger:focus-visible,
	.shared-navigation a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
	@media (max-width: 1024px) {
		.shared-navigation .nav-container { width: calc(100% - 2rem); padding: 0; gap: 1rem; }
		.shared-navigation .nav-links { gap: 1rem; }
	}
	@media (max-width: 768px) {
		.shared-navigation .nav-container { height: 64px; }
		.shared-navigation .nav-links {
			position: fixed;
			top: 64px;
			right: 0;
			left: 0;
			z-index: 1000;
			flex-direction: column;
			align-items: stretch;
			gap: .75rem;
			padding: 1rem 1.5rem 1.5rem;
			border-bottom: 1px solid var(--border);
			background: var(--bg-secondary);
			transform: translateY(-120%);
			visibility: hidden;
			transition: transform .2s ease, visibility .2s ease;
		}
		.shared-navigation .nav-links.active { transform: translateY(0); visibility: visible; }
		.shared-navigation .hamburger { display: flex; }
		.shared-navigation .hamburger.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
		.shared-navigation .hamburger.active span:nth-child(2) { opacity: 0; }
		.shared-navigation .hamburger.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
	}
	@media (prefers-reduced-motion: reduce) {
		.shared-navigation *, .shared-navigation *::before, .shared-navigation *::after { transition-duration: .01ms !important; }
	}
</style>

<script>
	const navLinks = document.getElementById('navLinks');
	const hamburger = document.getElementById('hamburger');

	if (navLinks && hamburger) {
		const setMenuOpen = (isOpen: boolean) => {
			navLinks.classList.toggle('active', isOpen);
			hamburger.classList.toggle('active', isOpen);
			hamburger.setAttribute('aria-expanded', String(isOpen));
			hamburger.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
		};

		hamburger.addEventListener('click', () => setMenuOpen(hamburger.getAttribute('aria-expanded') !== 'true'));
		navLinks.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setMenuOpen(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && hamburger.getAttribute('aria-expanded') === 'true') {
				setMenuOpen(false);
				hamburger.focus();
			}
		});
	}
</script>
